{
  "schema": "workflow-design/v1",
  "id": "simplify-verify-loop",
  "entry": "seed",
  "admission": {
    "reasons": [
      "multi-stage",
      "fanout-fanin",
      "lifecycle-boundary"
    ],
    "demotionCondition": "Use one bounded writer and one independent reviewer when three distinct verification perspectives and bounded revision rounds are unnecessary."
  },
  "governance": {
    "reviewPolicy": "independent",
    "completionProof": "none",
    "malformedDecision": "unresolved"
  },
  "goal": {
    "objective": "Remove unnecessary complexity from a real candidate while preserving its required behavior and claims.",
    "acceptance": "A candidate is ready only when its actual artifact, change report, acceptance output, and three independent review artifacts are bound as evidence and all three reviewers pass the same round."
  },
  "budgets": {
    "maxModelCalls": 15
  },
  "requiredCapabilities": [
    "agent-invocation",
    "fresh-sessions",
    "conditional-routing",
    "structured-output",
    "fanout-fanin",
    "durable-checkpoints",
    "observability"
  ],
