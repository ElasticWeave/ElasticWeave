  "reasoningPolicy": {
    "schema": "workflow-reasoning-policy/v2",
    "defaultPosture": "balanced",
    "selectionRule": "lowest-cost-qualified-role",
    "costMetric": "project-relative-routing-rank-not-dollar-price",
    "effortScope": "global-dispatch-envelope",
    "crossFamilyEffortComparable": false,
    "maxAutomaticEscalations": 0,
    "backendEffortLevels": {
      "claude": ["low", "medium", "high", "xhigh", "max"],
      "codex": ["low", "medium", "high", "xhigh", "max", "ultra"],
      "cursor": ["none", "low", "medium", "high", "xhigh", "max"]
    },
    "postures": {
      "economy": {
        "description": "Keep the main judgment route qualified and move bounded collection to verified Sonnet High or Luna Max roles.",
        "allowedRoles": ["smol", "tiny", "commit", "research_collect", "research_collect_anthropic", "research_analyze", "anthropic_task", "advisor", "codex_advisor"],
        "maxAutomaticEscalations": 0
      },
      "balanced": {
        "description": "Prefer GPT-6 Astra Max for the main executor, Opus 5 Max for advice or cross-provider review, and cost-qualified collection roles for evidence gathering.",
        "allowedRoles": ["smol", "tiny", "commit", "research_collect", "research_collect_anthropic", "research_analyze", "anthropic_task", "default", "vision", "plan", "slow", "task", "designer", "frontier_execute", "frontier_advice", "frontier_advice_astra", "advisor", "codex_advisor"],
        "maxAutomaticEscalations": 0
      },
      "frontier": {
        "description": "Use only verified Astra or Opus top-intelligence routes at Max or X-High and preserve exact cross-provider Max review pairings.",
        "allowedRoles": ["smol", "tiny", "commit", "research_collect", "research_collect_anthropic", "research_analyze", "anthropic_task", "default", "vision", "plan", "slow", "task", "designer", "frontier_execute", "frontier_execute_xhigh", "frontier_execute_anthropic", "frontier_execute_anthropic_xhigh", "frontier_advice", "frontier_advice_fable", "frontier_advice_astra", "diversity_grok", "advisor", "codex_advisor"],
        "maxAutomaticEscalations": 0
      }
    },
    "intelligenceClasses": {
      "mechanical": ["smol", "tiny", "commit"],
      "collection": ["research_collect", "research_collect_anthropic"],
      "analysis": ["research_analyze", "task", "default", "vision", "anthropic_task"],
      "topIntelligence": ["frontier_execute", "frontier_execute_xhigh", "frontier_execute_anthropic", "frontier_execute_anthropic_xhigh"],
      "planning": ["plan", "designer", "slow"],
      "advice": ["frontier_advice", "frontier_advice_fable", "frontier_advice_astra"],
      "verification": ["advisor", "codex_advisor"],
      "diversity": ["diversity_glm", "diversity_kimi", "diversity_grok"]
    },
    "rules": [
      "Choose the global posture once per issue or workflow and include it in every delegated brief.",
      "Use GPT-6 Astra Max as the preferred main executor; Astra X-High and Opus 5 Max or X-High are qualified alternatives only after live role resolution.",
      "Use Opus 5 for normal complex advice and Fable 5.1 or GPT-6 Astra for hard or materially uncertain advice or review after exact live route and retention-policy admission.",
      "Route bounded evidence collection to a live-verified Sonnet 5 High or Luna Max role instead of copying the main executor into collection leaves.",
      "Choose the cheapest qualified semantic role for each node and escalate only the failing judgment node, not deterministic reducers or independent collection branches.",
      "Treat effort names as provider-local settings; matching labels are requirements, not proof of cross-family capability equivalence.",
      "Completion review keeps its exact Max pairing; adaptive advice and diversity roles prefer Max and otherwise pin the highest fresh-catalog effort before dispatch.",
      "For a GPT-6 Astra Max or X-High writer use Opus 5 Max review; for an Opus 5 Max or X-High writer use GPT-6 Astra Max review.",
      "The shipped diversity_glm (GLM 5.2) and diversity_kimi (kimi-k3-max) entries are immutable Cursor compatibility snapshots; current GLM 5.3/5.3 Flash and Kimi k3 candidates follow the task-routing heuristic and must be admitted through their declared Claude Code route before dispatch. Grok 4.6 remains active only at the highest effort proven by the fresh Cursor catalog, and Humanize cannot substitute another backend.",
      "DeepSeek V4.1 Flash follows the task-routing heuristic through DSH or Codex as deepseek-flash; a separate Cursor candidate requires its exact model and highest provider-local effort in the live catalog. Composer 2.5 remains excluded until an explicit policy change.",
      "A workflow scheduler selects only from the legal frontier; node roles and effort are fixed before workflow start.",
      "A static workflow never changes roles automatically; escalation requires an explicitly expanded and validated branch in the current design and mapping, or a newly validated design and mapping before another run.",
      "Every ordinary native launch resolves one explicit task class, posture, semantic role, model, and effort into a policy-bound receipt; parent-model inheritance is forbidden.",
      "Any exact model id is a refreshable snapshot and must be checked against the authenticated native catalog before pinning or repinning; a static models file or structural receipt is not live authentication."
    ]
  },
