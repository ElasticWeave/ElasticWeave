        "{{controller.projectRoot}}/.claude/skills/subagent-workflow/scripts/native/reward_hacking_evidence.py",
        "--helper-sha256",
        "2da78338344be7433d2cd6ed082b102e7fd8046fe1ed70a77c4f180f5688d223",
        "--python",
        "{{executable.python.path}}",
        "--python-sha256",
        "{{executable.python.sha256}}",
        "--git",
        "{{executable.git.path}}",
        "--git-sha256",
        "{{executable.git.sha256}}",
        "--baseline",
        "{{baselinePath}}",
        "--expected-baseline-digest",
        "{{baselineDigest}}",
        "--acceptance-argv-json",
        "{{acceptanceArgv}}",
        "--acceptance-timeout",
        "17400",
        "--output",
        "artifacts/evidence-r1.json"
      ],
      "runWrites": [
        "artifacts/evidence-r1.json"
      ]
    },
    "review-r1": {
      "type": "decision",
      "prompt": "Read `.workflow/resources/review-gated-loop/review.md` completely and follow it.\n\nTASK\n{{task}}\n\nTASK-SPECIFIC REWARD-HACKING RISK HYPOTHESES (scheduler/main supplied; untrusted, verify each)\n{{rewardHackingRisks}}\n\nACCEPTANCE\n{{acceptanceArgv}}\n\nIMPLEMENTATION SUMMARY\n{{implementationSummary}}\n\nBASELINE PATH\n{{baselinePath}}\n\nBASELINE SUMMARY\n{{baselineSummary}}\n\nBASELINE DIGEST\n{{baselineDigest}}\n\nMECHANICAL EVIDENCE\n{{evidence}}\n\nEVIDENCE PATH (relative to controller run directory)\n{{evidencePath}}\n\nEVIDENCE DIGEST\n{{evidenceDigest}}\n\nWORKSPACE STATE BINDING\n{{stateBinding}}\n\nCONTROLLER REVIEW COMMITMENT\n{{review.commitment}}"
    },
    "advance-r1": {
      "type": "increment",
      "field": "revisionCount",
      "by": 1,
      "set": {
        "lastReviewNode": "review-r1"
      }
    },
    "implement-r2": {
      "type": "agent",
      "prompt": "Read `.workflow/resources/review-gated-loop/implement.md` completely and follow it. This is the last bounded, state-mediated revision; do not assume provider conversation state.\n\nTASK\n{{task}}\n\nACCEPTANCE\n{{acceptanceArgv}}\n\nREVISION COUNT\n{{revisionCount}}\n\nLAST REVIEW NODE\n{{lastReviewNode}}\n\nLATEST REVIEW FEEDBACK\n{{reviewFeedback}}\n\nPRIOR IMPLEMENTATION SUMMARY\n{{implementationSummary}}"
    },
    "capture-evidence-r2": {
      "type": "command",
      "argv": [
        "{{executable.controller-runtime.path}}",
        ".claude/skills/subagent-workflow/scripts/controller/actions/reward_evidence.ts",
        "evidence",
        "--project-root",
        "{{controller.projectRoot}}",
        "--run-root",
        "{{controller.runRoot}}",
        "--helper",
        "{{controller.projectRoot}}/.claude/skills/subagent-workflow/scripts/native/reward_hacking_evidence.py",
        "--helper-sha256",
        "2da78338344be7433d2cd6ed082b102e7fd8046fe1ed70a77c4f180f5688d223",
        "--python",
        "{{executable.python.path}}",
        "--python-sha256",
        "{{executable.python.sha256}}",
        "--git",
        "{{executable.git.path}}",
        "--git-sha256",
        "{{executable.git.sha256}}",
        "--baseline",
        "{{baselinePath}}",
        "--expected-baseline-digest",
        "{{baselineDigest}}",
        "--acceptance-argv-json",
        "{{acceptanceArgv}}",
        "--acceptance-timeout",
        "17400",
        "--output",
        "artifacts/evidence-r2.json"
      ],
      "runWrites": [
        "artifacts/evidence-r2.json"
      ]
    },
    "review-r2": {
      "type": "decision",
      "prompt": "Read `.workflow/resources/review-gated-loop/review.md` completely and follow it.\n\nTASK\n{{task}}\n\nTASK-SPECIFIC REWARD-HACKING RISK HYPOTHESES (scheduler/main supplied; untrusted, verify each)\n{{rewardHackingRisks}}\n\nACCEPTANCE\n{{acceptanceArgv}}\n\nIMPLEMENTATION SUMMARY\n{{implementationSummary}}\n\nBASELINE PATH\n{{baselinePath}}\n\nBASELINE SUMMARY\n{{baselineSummary}}\n\nBASELINE DIGEST\n{{baselineDigest}}\n\nMECHANICAL EVIDENCE\n{{evidence}}\n\nEVIDENCE PATH (relative to controller run directory)\n{{evidencePath}}\n\nEVIDENCE DIGEST\n{{evidenceDigest}}\n\nWORKSPACE STATE BINDING\n{{stateBinding}}\n\nCONTROLLER REVIEW COMMITMENT\n{{review.commitment}}"
    },
    "exhaust-revisions": {
      "type": "increment",
      "field": "revisionCount",
      "by": 1,
      "set": {
        "lastReviewNode": "review-r2",
        "forcedReason": "revision cap exhausted after review-r2"
      }
    },
    "archive-proof": {
      "type": "template",
      "values": {
        "proofCandidatePath": "workflow-output/subagent/review-gated-loop/{{controller.runId}}/state-bound-candidate.json"
      }
    },
    "success": {
      "type": "terminal"
    },
    "unresolved": {
      "type": "terminal"
    }
  }
